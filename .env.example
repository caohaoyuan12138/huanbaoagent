# 环境变量示例
# 复制为 .env 并填入实际值

# ── LLM 配置 ──
LLM_BASE_URL=https://apihub.agnes-ai.cn/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=agnes-2.0-flash

# ── JWT 认证 ──
JWT_SECRET_KEY=your-random-secret-key-change-in-production

# ── CORS ──
CORS_ORIGINS=https://your-domain.com,http://your-ip:80

# ── HJ212 园区平台 ──
PLATFORM_ADDRESS=your-platform-ip
PLATFORM_GAS_PORT=30541
PLATFORM_WATER_PORT=30542
