# 化工环保 Agent 环境配置模板
# 复制为 .env 并填入实际值

# ── LLM 配置 ──
LLM_BASE_URL=https://apihub.agnes-ai.cn/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=agnes-2.0-flash

# ── 搜索引擎配置（任选一个） ──
SEARCH_ENGINE=anysearch
ANYSEARCH_API_KEY=as_sk_xxxx
# TAVILY_API_KEY=tvly_xxxx

# ── 飞书通知配置（告警推送） ──
LARK_APP_ID=cli_xxxxxx
LARK_APP_SECRET=xxxxxx
LARK_ENCRYPT_KEY=xxxxxx
LARK_DEFAULT_RECEIVER_ID=open_xxxxxx
LARK_DEFAULT_RECEIVE_TYPE=open_id

# ── HJ212 园区平台对接（公约第五条） ──
# 园区智慧环保平台地址
PLATFORM_ADDRESS=183.93.165.90
# 废气端口
PLATFORM_GAS_PORT=30541
# 废水/雨水端口
PLATFORM_WATER_PORT=30542
